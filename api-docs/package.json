{
  "name": "@humanaios/api-docs",
  "version": "1.0.0",
  "description": "Auto-generated API documentation for HumanAIOS",
  "scripts": {
    "build": "npm run validate && npm run generate",
    "validate": "swagger-cli validate openapi/api-spec.yml",
    "generate": "redoc-cli build openapi/api-spec.yml -o dist/index.html --title 'HumanAIOS API Documentation'",
    "watch": "nodemon -w openapi/api-spec.yml -x npm run build",
    "serve": "http-server dist -p 8080",
    "changelog:generate": "node scripts/changelog-generator.js",
    "test:spec": "ajv compile -s openapi/api-spec.yml",
    "lint:spec": "swagger-cli validate openapi/api-spec.yml"
  },
  "keywords": [
    "api",
    "documentation",
    "openapi",
    "swagger",
    "redoc"
  ],
  "author": "HumanAIOS Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "redoc-cli": "^0.13.0",
    "@apidevtools/swagger-cli": "^4.0.4",
    "ajv": "^8.12.0",
    "nodemon": "^3.0.0",
    "http-server": "^14.1.0"
  }
}
