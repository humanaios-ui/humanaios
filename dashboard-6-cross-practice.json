          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | source_practice != \"\" | target_practice != \"\" | count by source_practice, target_practice, avg(duration_ms)"
