{
  "dashboard": {
    "title": "Cross-Practice Integration",
    "description": "Mesh-wide coordination and bottleneck detection",
    "tags": [
      "phase-3.5",
      "observability"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Practice Health Score",
        "type": "heatmap",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | practice != \"\" | avg(vector_values) by practice"
          }
        ],
        "options": {
          "calculate": false,
          "cellGap": 2,
          "cellRadius": 2,
          "color": {
            "scheme": "Spectral"
          },
          "exemplars": {
            "color": "rgba(255,0,255,0.7)"
          },
          "filterValues": {
            "le": 1e-09
          },
          "legend": {
            "show": true
          },
          "tooltip": {
            "enabled": true
          }
        }
      },
      {
        "title": "autonomy Requests",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 2.4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{practice=\"autonomy\"} | count"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {}
          }
        }
      },
