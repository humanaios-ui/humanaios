{
  "dashboard": {
    "title": "Multi-Practice Traces",
    "description": "Request flow across practice boundaries",
    "tags": [
      "phase-3.5",
      "observability"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Count by Source\u2192Target",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | source_practice != \"\" | target_practice != \"\" | count by source_practice, target_practice"
          }
        ],
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table"
          },
          "tooltip": {
            "mode": "multi"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      {
        "title": "Request Type Distribution",
        "type": "piechart",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | request_type != \"\" | count by request_type"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          },
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "title": "Trace Latency Percentiles (ms)",
        "type": "timeseries",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | duration_ms > 0 | quantile_over_time(0.5, duration_ms[5m]) as p50, quantile_over_time(0.95, duration_ms[5m]) as p95, quantile_over_time(0.99, duration_ms[5m]) as p99"
          }
        ],
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table"
          },
          "tooltip": {
            "mode": "multi"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      {
        "title": "Error Traces (last 50)",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | result=\"error\" | timestamp, source_practice, target_practice, error_type"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": []
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ]
    }
  }
}