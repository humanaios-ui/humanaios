{
  "dashboard": {
    "title": "Empirica Phase Latency",
    "description": "Transaction phase duration trends (PREFLIGHT \u2192 CHECK \u2192 POSTFLIGHT)",
    "tags": [
      "phase-3.5",
      "observability"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Phase Duration Trend (ms)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | phase != \"\" | duration_ms > 0"
          }
        ],
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table"
          },
          "tooltip": {
            "mode": "multi"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      {
        "title": "PREFLIGHT P95",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 3,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\", phase=\"PREFLIGHT\"} | json | duration_ms > 0 | quantile_over_time(0.95, duration_ms[5m])"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {}
          }
        }
      },
      {
        "title": "CHECK P95",
        "type": "stat",
        "gridPos": {
          "x": 3,
          "y": 8,
          "w": 3,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\", phase=\"CHECK\"} | json | duration_ms > 0 | quantile_over_time(0.95, duration_ms[5m])"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {}
          }
        }
      },
      {
        "title": "POSTFLIGHT P95",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 3,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\", phase=\"POSTFLIGHT\"} | json | duration_ms > 0 | quantile_over_time(0.95, duration_ms[5m])"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {}
          }
        }
      },
      {
        "title": "SLA Compliance",
        "type": "stat",
        "gridPos": {
          "x": 9,
          "y": 8,
          "w": 3,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | duration_ms < 300 | count / ({job=\"empirica-sessions\"} | count)"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {}
          }
        }
      },
      {
        "title": "Duration by Practice & Phase (ms)",
        "type": "heatmap",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"empirica-sessions\"} | json | practice != \"\" | phase != \"\" | duration_ms > 0"
          }
        ],
        "options": {
          "calculate": false,
          "cellGap": 2,
          "cellRadius": 2,
          "color": {
            "scheme": "Spectral"
          },
          "exemplars": {
            "color": "rgba(255,0,255,0.7)"
          },
          "filterValues": {
            "le": 1e-09
          },
          "legend": {
            "show": true
          },
          "tooltip": {
            "enabled": true
          }
        }
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ]
    }
  }
}