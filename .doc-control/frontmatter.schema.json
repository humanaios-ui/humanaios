{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Controlled Document Frontmatter Schema",
  "description": "YAML frontmatter validation for HAIOS controlled documents (per DOCUMENT_CONTROL_PLAN.md §3.1)",
  "type": "object",
  "required": [
    "doc_id",
    "title",
    "revision",
    "status",
    "owner"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^HAIOS-[A-Z]+-[0-9]{3}$",
      "description": "Unique stable identifier. Format: HAIOS-<AREA>-<nnn>. Areas: GOV, PROC, SPEC, TEST, VIS, OPS."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Human-readable document title"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Integer revision number; bumps on approved change"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ],
      "description": "Document lifecycle state"
    },
    "owner": {
      "type": "string",
      "pattern": "^@([a-z-]+|humanaios-foundation/[a-z-]+)$",
      "description": "Owner identifier. Format: @name or @humanaios-foundation/team-name"
    },
    "approved_by": {
      "type": "string",
      "description": "Username of approver (required when status=approved)",
      "pattern": "^[a-z0-9._-]+$"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "Approval date in YYYY-MM-DD format (required when status=approved)"
    },
    "created_date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date in YYYY-MM-DD format"
    },
    "review_due": {
      "type": "string",
      "format": "date",
      "description": "When this document is next due for review (drives staleness monitor)"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^HAIOS-[A-Z]+-[0-9]{3}$",
      "description": "doc_id of the document this replaces (if applicable)"
    },
    "canonical": {
      "type": "boolean",
      "const": true,
      "description": "Must be true (enforced by CI); exactly one canonical per doc_id across all repos"
    },
    "retention": {
      "type": "string",
      "enum": [
        "permanent",
        "7y",
        "3y",
        "superseded-only"
      ],
      "default": "permanent",
      "description": "Retention period (ISO 9001 §7.5 compliance)"
    },
    "related_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HAIOS-[A-Z]+-[0-9]{3}$"
      },
      "description": "doc_ids of related documents (optional)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "approved_by",
          "approved_date"
        ]
      }
    }
  ]
}
