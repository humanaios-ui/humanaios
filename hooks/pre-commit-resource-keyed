#!/usr/bin/env python3
"""
Pre-commit hook: Temporal drift prevention.
Rejects commits containing temporal language.
Catches ~80% of instances at syntax level.
"""

import subprocess
import re
import sys

TEMPORAL_PATTERN = re.compile(
    r'\b(?:'
    # Days of week (standalone)
    r'monday|tuesday|wednesday|thursday|friday|saturday|sunday|'
    # Deadline/schedule language
    r'deadline|due\s+(?:by|on)|schedule(?!d)|scheduled|'
    r'timeline|roadmap|milestone|sprint|'
    # Temporal phrases (higher confidence)
    r'by\s+(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)|'  # "by Friday"
    r'by\s+(?:january|february|march|april|may|june|july|august|september|october|november|december)|'  # "by September"
    r'until\s+(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)|'  # "until Friday"
    r'(?:in|during)\s+(?:week|month|year)(?:\s+\d+)?|'  # "during week 3"
    # Date patterns (year-month-day format only)
    r'\d{4}-\d{2}-\d{2}|'  # "2026-09-15" ONLY
    # Temporal qualifiers (high confidence only)
    r'immediately|asap|(?<!allocated\s)(?<!by\s)now(?!\s+)?|soon|'
    r'later|eventually|(?<!very\s)first|next\s+(?:week|month|year|monday|tuesday|wednesday|thursday|friday)|'
    r'last\s+(?:week|month|year)|'
    r'previous|prior\s+(?:to|week)'
    r')\b',
    re.IGNORECASE
)

def get_commit_message():
    """Retrieve the staged commit message."""
    try:
        commit_msg_file = sys.argv[1] if len(sys.argv) > 1 else None
        if commit_msg_file:
            with open(commit_msg_file, 'r') as f:
                return f.read()
    except Exception:
        pass
    return ""

def check_temporal_language(message):
    """Check for temporal language in commit message."""
    matches = TEMPORAL_PATTERN.findall(message)
    return matches

def main():
    message = get_commit_message()

    # Skip empty or merge commits
    if not message or message.startswith('Merge branch'):
        return 0

    temporal_words = check_temporal_language(message)

    if temporal_words:
        print("\n❌ COMMIT REJECTED: Temporal language detected")
        print("━" * 60)
        print(f"Found: {', '.join(set(temporal_words))}")
        print("\nUse resource-based framing instead:")
        print("  ✗ 'by Friday' → ✓ 'when practices consume allocated labor'")
        print("  ✗ 'Week 1' → ✓ 'when practices return metrics'")
        print("  ✗ 'deadline Sep 20' → ✓ 'phase-gate resolution on metric consummation'")
        print("━" * 60)
        return 1

    return 0

if __name__ == '__main__':
    sys.exit(main())
