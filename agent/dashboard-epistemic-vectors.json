          }
        },
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "title": "Commits (24h)",
        "type": "stat",
        "gridPos": {
