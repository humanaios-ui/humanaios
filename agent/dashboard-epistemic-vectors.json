          },
          {
            "refId": "D",
            "expr": "empirica_clarity_gauge"
          },
          {
            "refId": "E",
            "expr": "empirica_coherence_gauge"
          },
          {
            "refId": "F",
            "expr": "empirica_signal_gauge"
          },
          {
            "refId": "G",
            "expr": "empirica_density_gauge"
          },
          {
            "refId": "H",
            "expr": "empirica_state_gauge"
          },
          {
            "refId": "I",
            "expr": "empirica_change_gauge"
          },
          {
            "refId": "J",
            "expr": "empirica_completion_gauge"
