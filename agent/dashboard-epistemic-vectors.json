          },
          {
            "refId": "M",
            "expr": "empirica_uncertainty_gauge"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 50,
              "gradientMode": "none",
              "lineWidth": 1,
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            },
            "max": 1.0,
            "min": 0.0
          }
        },
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 2,
        "title": "Phase Duration — Noetic vs Praxic",
        "type": "barchart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "expr": "increase(empirica_noetic_duration_seconds_bucket[1h])",
            "legendDisplayMode": "list"
          },
          {
            "refId": "B",
            "expr": "increase(empirica_praxic_duration_seconds_bucket[1h])"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 70
            }
          }
        },
        "options": {
          "legend": {
            "calcs": ["sum", "mean"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "orientation": "auto"
        }
      },
      {
        "id": 3,
        "title": "Artifact Production Rate (24h)",
        "type": "stat",
        "gridPos": {
