      {
        "title": "Brier Error Trend by Vector",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"acat-grounding\"} | json | vector_name != \"\" | avg(brier_error) by vector_name"
          }
        ],
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table"
          },
          "tooltip": {
            "mode": "multi"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      {
        "title": "Calibration by Practice",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "Loki",
            "expr": "{job=\"acat-grounding\"} | json | ai_id != \"\" | avg(brier_error) by ai_id"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": []
      }
